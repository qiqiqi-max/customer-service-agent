# Set MOCK_MODE=True for local development without cloud resources.
MOCK_MODE=True
LANGUAGE=zh
LLM_PROVIDER=volcengine
KNOWLEDGE_PROVIDER=volcengine

# Dify knowledge base mode. Set MOCK_MODE=False and KNOWLEDGE_PROVIDER=dify.
DIFY_API_KEY=your_dify_api_key
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_DATASET_ID=your_product_dataset_id
DIFY_FAQ_DATASET_ID=your_faq_dataset_id
DIFY_TOP_K=5
DIFY_SCORE_THRESHOLD_ENABLED=False
DIFY_SCORE_THRESHOLD=0
CONVERSATION_DB_PATH=./data/conversations.sqlite3

# Optional API key auth for standard /api/* business endpoints.
# Separate multiple keys with commas. Leave empty for local development.
API_KEYS=

# Business data source. Use mock for local demo data.
# Set BUSINESS_DATA_PROVIDER=http to call your real order/logistics/refund API.
BUSINESS_DATA_PROVIDER=mock
BUSINESS_API_BASE_URL=https://your-business-api.example.com
BUSINESS_API_KEY=your_business_api_key
BUSINESS_API_TIMEOUT=8

# Observability. Logs are JSON lines written to LOG_DIR/app.log.
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_TO_STDOUT=False

# DeepSeek/OpenAI-compatible mode. Set MOCK_MODE=False and LLM_PROVIDER=deepseek.
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseekv4pro

# Zhipu/OpenAI-compatible mode. Set MOCK_MODE=False and LLM_PROVIDER=zhipu.
ZHIPU_API_KEY=your_zhipu_api_key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_MODEL=glm-5.2

# VolcEngine mode. Required only when MOCK_MODE=False and LLM_PROVIDER=volcengine.
VOLC_ACCESSKEY=your_ak
VOLC_SECRETKEY=your_sk
COLLECTION_NAME=your_product_collection
FAQ_COLLECTION_NAME=your_faq_collection
LLM_ENDPOINT_ID=doubao-seed-1-6-250615
BUCKET_NAME=your_bucket_name
USE_SERVER_AUTH=True
ARK_API_KEY=your_ark_api_key
